# Copy to .env and fill in. .env is git-ignored. No Google secret goes here:
# the OAuth client secret lives only in n8n credentials (and secrets/google_oauth_client.json).

# --- n8n (runs natively at http://localhost:5678 - must match the OAuth redirect URI)
N8N_USER_FOLDER=C:\Users\<you>\facture\storage\n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Africa/Tunis
TZ=Africa/Tunis
# random 32+ chars; keeps credentials decryptable across restarts - never change it once set
N8N_ENCRYPTION_KEY=
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# --- local services (no invoice data ever leaves the PC except to your own Google account)
OCR_URL=http://127.0.0.1:8000/extract
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_FALLBACK_MODEL=qwen3:8b

# --- Google (IDs only, filled by the setup workflow)
GOOGLE_ACCOUNT=you@gmail.com
MANAGER_EMAIL=you@gmail.com
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GMAIL_LABEL_NAME=INVOICE_AUTOMATION
GMAIL_LABEL_ID=

# --- business rules
APPROVAL_THRESHOLD=2000
MIN_CONFIDENCE=0.8
AMOUNT_TOLERANCE=0.01
COMPANY_TAX_ID=5555555/D/A/000

# optional: on (re)activation, also process matching UNREAD emails received since this day (YYYY-MM-DD)
GMAIL_BACKFILL_SINCE=
# optional: Gmail search used by the trigger (default: attachment + label INVOICE_AUTOMATION or "facture"/"invoice" in subject)
GMAIL_QUERY=
